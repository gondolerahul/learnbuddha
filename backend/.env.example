# Copy to backend/.env and fill in.
DATABASE_URL=postgresql+psycopg://learnbuddha@localhost:5433/learnbuddha

# Claude (planner, scene writer). Leave empty to use the offline mock brain.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Gemini (narration TTS + live voice tutor). Leave empty to fall back to Windows SAPI / silent narration
# and the typed (Claude) tutor.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_LIVE_MODEL=gemini-3.8-live

# Providers: auto | anthropic | mock   ·   auto | gemini | sapi | silent   ·   auto | gemini | text
# Costs are shown in INR. Leave USD_INR empty to fetch the rate every 12 h (FX_LIVE=true), or fix it here.
# USD_INR=94.29
# FX_LIVE=true

BRAIN_PROVIDER=auto  # auto | anthropic | gemini | mock (default; each course can pick)
TTS_PROVIDER=auto
VOICE_PROVIDER=auto


# Rendering
RENDER_WIDTH=1280
RENDER_HEIGHT=720
RENDER_FPS=24
WORKER_THREADS=8
# How hard the model thinks before writing a scene or answer: low | medium | high (lower is faster and cheaper).
SCENE_THINKING=medium
# ...and for what a learner is waiting on (first scene, visual answers, re-explanations).
URGENT_THINKING=low
RUN_WORKER_IN_PROCESS=true

# ── Google models on GCP Vertex AI (Gemini Enterprise Agent Platform) ──
# Setting a project switches the Gemini brain, TTS and Live voice to Vertex AI (auth: ADC via
# `gcloud auth application-default login`, or a service-account JSON below). The project is never
# taken from your gcloud default config.
GOOGLE_GENAI_BACKEND=auto
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Gemini 4: the `us` multi-region gave the fewest eligibility 403s in testing
GEMINI_BRAIN_LOCATION=us
GEMINI_LIVE_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# gemini-4-hydrogen is fast and cheap; gemini-4-carbon is slower and dearer. The fallback is used on 403/404.
GEMINI_BRAIN_MODEL=gemini-4-hydrogen
GEMINI_BRAIN_FALLBACK_MODEL=gemini-4-argon

# Lesson renders allowed at once (0 = automatic: 3). Try 1 on a machine with steady clocks: one render at a time on
# more threads can get the first scene out sooner. Answers, recaps and re-explanations never wait.
# RENDER_SLOTS=0
# Threads per scene render (frames drawn in parallel, streamed to ffmpeg in order). 0 = automatic (the cores shared
# between the render slots, at most two thirds of them on one render).
# RENDER_THREADS=0
